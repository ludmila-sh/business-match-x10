---
import Base from "../layouts/Base.astro";

const description = "Информация о политике обработки персональных данных клуба Бизнес Мэтч.";
---

<Base title="Персональные данные — Бизнес Мэтч" description={description} noindex>
  <main class="privacy">
    <a href="/">← На главную</a>
    <p class="eyebrow">Бизнес Мэтч</p>
    <h1>Политика обработки персональных данных</h1>
    <div class="notice">
      <strong>Черновик — не публиковать как действующую политику.</strong>
      <p>Перед запуском команде нужно определить оператора персональных данных и согласовать текст с юристом.</p>
    </div>
    <p>Эта страница оставлена в структуре сайта как место для утверждённой политики. Сейчас сайт не содержит собственной формы регистрации и не просит посетителей отправлять персональные данные.</p>
    <p>Если на сайт добавится ссылка на стороннюю форму регистрации, команда должна отдельно согласовать уведомление и текст согласия для этой формы.</p>
    <p class="todo">TODO: указать оператора, цели и основания обработки, состав данных, сроки хранения, права субъектов и контакт для обращений после юридического согласования.</p>
  </main>
</Base>

<style>
  .privacy { width:min(100% - 40px,760px); margin:0 auto; padding:54px 0 90px; color:#202b43; font:1rem/1.7 system-ui,sans-serif; }
  .privacy a { color:#1d3f8f; }
  .eyebrow { margin-top:42px; color:#8a6828; font-size:.75rem; font-weight:700; letter-spacing:.1em; text-transform:uppercase; }
  h1 { max-width:650px; font-size:clamp(2rem,6vw,3.5rem); line-height:1.05; letter-spacing:-.04em; }
  .notice { margin:28px 0; padding:18px 20px; border-left:3px solid var(--gold-on-light); background:#f2eee5; }
  .notice p { margin:6px 0 0; }
  .todo { padding-top:15px; border-top:1px solid #d8d2c5; color:#6b7180; font-size:.9rem; }
</style>
