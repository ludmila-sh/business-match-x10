---
import { Image } from "astro:assets";
import logo from "../assets/logo-mark.png";
import heroPhoto from "../assets/hero-stock-photo.jpg";
import { site } from "../lib/site";
---

<section class="hero" id="top">
  <Image class="hero-photo" src={heroPhoto} alt="" widths={[800, 1280, 1920]} sizes="100vw" loading="eager" fetchpriority="high" />
  <div class="hero-shade" aria-hidden="true"></div>
  <div class="hero-wrap">
    <header class="site-header">
      <a class="brand" href="#top" aria-label={`${site.name} — на главную`}>
        <Image src={logo} alt="" width={72} loading="eager" />
        <span class="brand-copy"><strong>{site.name}</strong><span>{site.tagline}</span></span>
      </a>
      <nav aria-label="Навигация по странице">
        <a href="#about">О клубе</a><a href="#format">Формат</a><a href="#faq">Вопросы</a>
      </nav>
    </header>

    <div class="hero-content">
      <div class="hero-copy">
        <p class="eyebrow"><span class="eyebrow-mark"></span> Предприниматели и эксперты · Минск</p>
        <h1>{site.name}</h1>
        <p class="descriptor">{site.tagline}</p>
        <p class="lead">Ежемесячные встречи, где предприниматели находят возможности для совместных проектов.</p>
        <a class="button button-primary" href="#next-meeting">Узнать о ближайшей встрече <span aria-hidden="true">→</span></a>
      </div>
    </div>

    <footer class="hero-footer"><span class="photo-note">Временное стоковое фото · заменим на снимок встречи клуба</span><a href="#about" class="scroll-cue">Подробнее о клубе <span aria-hidden="true">↓</span></a></footer>
  </div>
</section>

<style>
  .hero { position: relative; display: flex; min-height: 100svh; overflow: hidden; color: #fff; background: #10264f; isolation: isolate; }
  .hero-photo, .hero-shade { position: absolute; z-index: -1; inset: 0; width: 100%; height: 100%; }
  .hero-photo { object-fit: cover; object-position: center 42%; }
  .hero-shade { background: linear-gradient(90deg, rgba(7, 20, 47, .9), rgba(9, 27, 61, .7) 55%, rgba(10, 28, 58, .28)), linear-gradient(0deg, rgba(7, 17, 38, .38), transparent 62%); }
  .hero-wrap { display: flex; flex: 1; flex-direction: column; width: min(100%, 1280px); min-height: 100svh; margin: 0 auto; padding: 22px 28px 20px; }
  .site-header { display: flex; align-items: center; justify-content: space-between; gap: 20px; min-height: 88px; }
  .brand { display: inline-flex; align-items: center; gap: 13px; color: #fff; text-decoration: none; }
  .brand img { width: 66px; height: auto; filter: drop-shadow(0 2px 8px rgba(0,0,0,.25)); }
  .brand-copy { display: grid; gap: 3px; text-shadow: 0 1px 12px rgba(0,0,0,.25); }
  .brand-copy strong { font-size: 1.12rem; letter-spacing: .01em; }
  .brand-copy span { color: #e0e7f2; font-size: .79rem; }
  nav { display: flex; gap: clamp(18px, 3vw, 36px); }
  nav a { color: #f0f3f9; font-size: .9rem; text-decoration: none; }
  nav a:hover { color: #f1d695; }
  .hero-content { width: 100%; margin: auto 0; padding: 70px 0 90px; }
  .hero-copy { max-width: 710px; }
  .eyebrow { display: flex; align-items: center; gap: 10px; margin: 0 0 18px; color: #f0d28a; font-size: .74rem; font-weight: 700; letter-spacing: .1em; text-transform: uppercase; }
  .eyebrow-mark { width: 22px; height: 2px; background: #d6b361; }
  h1 { margin: 0; color: #fff; font-size: clamp(3.2rem, 6.2vw, 5.25rem); font-weight: 700; letter-spacing: -.055em; line-height: .98; text-shadow: 0 2px 24px rgba(0,0,0,.25); }
  .descriptor { display: inline-block; margin: 14px 0 0; padding: 0; color: #f4dc9d; font-size: .95rem; font-weight: 650; }
  .lead { max-width: 510px; margin: 15px 0 24px; color: #e2e8f1; font-size: clamp(1rem, 1.5vw, 1.12rem); line-height: 1.6; }
  .button { display: inline-flex; justify-content: center; align-items: center; gap: 18px; min-height: 50px; padding: 0 19px; border: 1px solid #e2c57e; border-radius: 3px; color: #14264a; background: #e2c57e; font-size: .9rem; font-weight: 750; text-align: center; text-decoration: none; transition: background-color .15s ease, color .15s ease; }
  .button span { font-size: 1.15rem; }
  .button-primary:hover { color: #fff; background: #17366d; }
  .hero-footer { display: flex; align-items: center; justify-content: space-between; gap: 18px; margin-top: auto; }
  .photo-note { margin: 0; color: rgba(255,255,255,.72); font-size: .68rem; text-shadow: 0 1px 6px rgba(0,0,0,.5); }
  .scroll-cue { display: inline-flex; align-items: center; gap: 10px; color: #fff; font-size: .78rem; text-decoration: none; }
  .scroll-cue span { color: #f1d695; }
  @media (min-width: 900px) { .hero-wrap { padding-right: 46px; padding-left: 46px; } }
  @media (max-width: 760px) {
    .hero { min-height: 100svh; }
    .hero-photo { object-position: 57% center; }
    .hero-shade { background: linear-gradient(180deg, rgba(8, 23, 51, .42), rgba(7, 19, 44, .64) 55%, rgba(7, 19, 44, .84)), linear-gradient(90deg, rgba(7, 19, 44, .35), rgba(7, 19, 44, .05)); }
    .hero-wrap { min-height: 100svh; padding: 12px 20px 16px; }
    .site-header { min-height: 72px; }
    .brand { gap: 10px; }
    .brand img { width: 52px; }
    .brand-copy strong { font-size: .98rem; }
    .brand-copy span { max-width: 240px; font-size: .71rem; }
    nav { display: none; }
    .hero-content { margin: auto 0; padding: 38px 0 46px; }
    .hero-copy { max-width: 540px; }
    .eyebrow { margin-bottom: 14px; font-size: .64rem; letter-spacing: .08em; }
    .eyebrow-mark { width: 17px; }
    h1 { font-size: clamp(2.5rem, 10.8vw, 4rem); line-height: 1; }
    .descriptor { margin-top: 11px; font-size: .88rem; }
    .lead { max-width: 400px; margin: 13px 0 20px; font-size: .95rem; line-height: 1.5; }
    .button { min-height: 48px; padding: 0 15px; font-size: .84rem; }
    .hero-footer { align-items: flex-end; }
    .photo-note { max-width: 210px; font-size: .61rem; line-height: 1.45; }
    .scroll-cue { gap: 7px; font-size: .7rem; white-space: nowrap; }
  }
  @media (max-width: 380px) { .hero-wrap { padding-right: 16px; padding-left: 16px; } .hero-content { padding: 28px 0 38px; } h1 { font-size: 2.4rem; } .scroll-cue { font-size: .64rem; } }
  @media (prefers-reduced-motion: reduce) { .button { transition: none; } }
</style>
