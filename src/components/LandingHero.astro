---
import { Image } from "astro:assets";
import logo from "../assets/logo-mark.png";
import heroPhoto from "../assets/hero-stock-photo.jpg";
import { hasAnnouncedMeeting, site } from "../lib/site";

const meetingAnnounced = hasAnnouncedMeeting();
---

<header class="site-header">
  <div class="header-inner">
      <a class="brand" href="#top" aria-label={`${site.name} — на главную`}>
        <Image src={logo} alt="" width={72} loading="eager" />
        <span class="brand-copy"><strong>{site.name}</strong><span>{site.tagline}</span></span>
      </a>
      <nav class="desktop-nav" aria-label="Навигация по странице">
        <a href="#about">О клубе</a><a href="#format">Формат</a><a href="#faq">Вопросы</a>
      </nav>
      <details class="mobile-nav">
        <summary aria-label="Меню сайта" aria-controls="mobile-menu"><span class="sr-only">Меню</span><span class="menu-icon" aria-hidden="true"><i></i><i></i><i></i></span></summary>
      </details>
  </div>
  <nav class="mobile-menu" id="mobile-menu" aria-label="Навигация по странице"><a href="#about">О клубе</a><a href="#for-whom">Для кого</a><a href="#format">Формат встречи</a><a href="#faq">Вопросы</a><a href="#next-meeting">Ближайшая встреча</a></nav>
</header>

<section class="hero" id="top">
  <Image class="hero-photo" src={heroPhoto} alt="" widths={[800, 1280, 1920]} sizes="100vw" loading="eager" fetchpriority="high" />
  <div class="hero-shade" aria-hidden="true"></div>
  <div class="hero-wrap">
    <div class="hero-content">
      <div class="hero-copy">
        <p class="hero-eyebrow">СОВМЕСТНЫЕ ПРОЕКТЫ · МИНСК</p>
        <h1>{site.name}</h1>
        <p class="descriptor">{site.tagline}</p>
        <p class="lead">{site.summary}</p>
        {meetingAnnounced ? (
          <a class="button button-primary" href={site.nextMeeting.registrationUrl} target="_blank" rel="noopener noreferrer">Записаться на встречу <span aria-hidden="true">→</span></a>
        ) : site.contacts.telegramUrl ? (
          <a class="button button-primary" href={site.contacts.telegramUrl} target="_blank" rel="noopener noreferrer">Следить за анонсом <span aria-hidden="true">→</span></a>
        ) : (
          <a class="button button-primary" href="#next-meeting">Узнать о ближайшей встрече <span aria-hidden="true">→</span></a>
        )}
      </div>
    </div>

    <footer class="hero-footer"><a href="#about" class="scroll-cue">Подробнее о клубе <span aria-hidden="true">↓</span></a></footer>
  </div>
</section>

{meetingAnnounced ? (
  <a class="mobile-sticky-cta" href={site.nextMeeting.registrationUrl} target="_blank" rel="noopener noreferrer" aria-hidden="true" inert>Записаться на встречу <span aria-hidden="true">→</span></a>
) : site.contacts.telegramUrl ? (
  <a class="mobile-sticky-cta" href={site.contacts.telegramUrl} target="_blank" rel="noopener noreferrer" aria-hidden="true" inert>Следить за анонсом <span aria-hidden="true">→</span></a>
) : (
  <a class="mobile-sticky-cta" href="#next-meeting" aria-hidden="true" inert>Ближайшая встреча <span aria-hidden="true">→</span></a>
)}

<script>
  const mobileNav = document.querySelector<HTMLDetailsElement>(".mobile-nav");
  const mobileLinks = document.querySelectorAll<HTMLAnchorElement>("#mobile-menu a");
  const hero = document.querySelector<HTMLElement>(".hero");
  const header = document.querySelector<HTMLElement>(".site-header");
  const meetingSection = document.querySelector<HTMLElement>("#next-meeting");
  const stickyCta = document.querySelector<HTMLAnchorElement>(".mobile-sticky-cta");
  const heroCta = document.querySelector<HTMLElement>(".hero-copy > .button");

  const updateHeader = () => header?.classList.toggle("is-scrolled", window.scrollY > 20);
  updateHeader();
  window.addEventListener("scroll", updateHeader, { passive: true });

  mobileLinks.forEach((link) => {
    link.addEventListener("click", () => {
      if (mobileNav) mobileNav.open = false;
    });
  });

  if (hero && stickyCta && "IntersectionObserver" in window) {
    let heroCtaIsVisible = true;
    let meetingIsVisible = false;
    let hasShownStickyCta = false;
    const updateStickyCta = () => {
      const isVisible = window.matchMedia("(max-width: 719px)").matches &&
        !heroCtaIsVisible && !meetingIsVisible;
      if (isVisible && !hasShownStickyCta) {
        stickyCta.setAttribute("data-entrance", "true");
        hasShownStickyCta = true;
      }
      stickyCta.toggleAttribute("data-visible", isVisible);
      stickyCta.setAttribute("aria-hidden", String(!isVisible));
      stickyCta.inert = !isVisible;
    };
    let stickyUpdateScheduled = false;
    const scheduleStickyUpdate = () => {
      if (stickyUpdateScheduled) return;
      stickyUpdateScheduled = true;
      window.requestAnimationFrame(() => {
        stickyUpdateScheduled = false;
        updateStickyCta();
      });
    };
    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.target === heroCta) heroCtaIsVisible = entry.isIntersecting;
        if (entry.target === meetingSection) meetingIsVisible = entry.isIntersecting;
      });
      updateStickyCta();
    }, { threshold: 0 });
    if (heroCta) observer.observe(heroCta);
    if (meetingSection) observer.observe(meetingSection);
    window.addEventListener("scroll", scheduleStickyUpdate, { passive: true });
    window.addEventListener("resize", scheduleStickyUpdate, { passive: true });
  }
</script>

<style>
  .site-header { position: fixed; z-index: 30; top: 0; right: 0; left: 0; height: 88px; background: transparent; box-shadow: none; transition: background-color .24s ease, box-shadow .24s ease; }
  .site-header.is-scrolled, .site-header:has(.mobile-nav[open]) { background: var(--landing-navy); box-shadow: 0 4px 16px rgba(4,16,31,.12); }
  .header-inner { display: flex; align-items: center; justify-content: space-between; gap: 20px; width: min(100%,1164px); height: 100%; margin: 0 auto; padding: 0 22px; }
  .hero { position: relative; display: flex; min-height: 100svh; overflow: hidden; color: #fff; background: var(--landing-navy); isolation: isolate; }
  .hero-photo, .hero-shade { position: absolute; inset: 0; width: 100%; height: 100%; }
  .hero-photo { z-index: 0; object-fit: cover; object-position: center 42%; }
  .hero-shade { z-index: 1; background: linear-gradient(90deg, rgba(7, 18, 37, .9) 0%, rgba(9, 22, 43, .72) 30%, rgba(9, 22, 43, .48) 55%, rgba(9, 22, 43, .28) 100%), linear-gradient(180deg, rgba(7, 18, 37, .35) 0%, rgba(9, 22, 43, .3) 48%, rgba(7, 18, 37, .68) 100%); }
  .hero-wrap { position: relative; z-index: 2; display: flex; flex: 0 1 auto; flex-direction: column; width: min(100%, 1164px); min-height: 100svh; margin: 0 auto; padding: 22px 22px 20px; }
  .brand { display: inline-flex; align-items: center; gap: 13px; color: #fff; text-decoration: none; }
  .brand img { flex: 0 0 auto; width: 66px; height: auto; filter: brightness(.88) saturate(.76) contrast(1.05) drop-shadow(0 2px 8px rgba(0,0,0,.25)); }
  .brand-copy { display: grid; gap: 3px; text-shadow: 0 1px 12px rgba(0,0,0,.25); }
  .brand-copy strong { font-size: 1.12rem; letter-spacing: .01em; }
  .brand-copy span { color: #e0e7f2; font-size: .79rem; }
  .desktop-nav { display: flex; gap: clamp(18px, 3vw, 36px); }
  .desktop-nav a { color: #f0f3f9; font-size: .9rem; text-decoration: none; }
  .desktop-nav a:hover { color: var(--gold-on-dark); }
  .mobile-nav, .mobile-menu { display: none; }
  .sr-only { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0,0,0,0); white-space: nowrap; clip-path: inset(50%); }
  .hero-content { width: 100%; margin: 0; padding: clamp(90px, 13vh, 160px) 0 clamp(90px, 13vh, 160px); }
  .hero-copy { max-width: 710px; }
  .hero-eyebrow { margin: 0 0 14px; color: var(--gold-on-dark); font-size: .75rem; font-weight: 750; letter-spacing: .12em; text-wrap: balance; }
  h1 { margin: 0; color: #fff; font-size: clamp(3rem, 5.8vw, 5rem); font-weight: 650; letter-spacing: -.055em; line-height: .98; text-shadow: 0 2px 24px rgba(0,0,0,.25); text-wrap: balance; }
  .descriptor { display: inline-block; margin: 14px 0 0; padding: 0; color: #fff; font-size: 1rem; font-weight: 650; letter-spacing: .01em; text-shadow: 0 1px 12px rgba(0,0,0,.32); }
  .lead { max-width: 510px; margin: 15px 0 0; color: #e2e8f1; font-size: clamp(1rem, 1.5vw, 1.12rem); line-height: 1.6; text-wrap: pretty; }
  .hero-copy > .button { margin-top: 32px; }
  .button { display: inline-flex; justify-content: center; align-items: center; gap: 18px; min-height: 50px; padding: 16px 28px; border: 1px solid transparent; border-radius: 10px; color: #0A182E; background: linear-gradient(var(--gold-on-dark), var(--gold-on-dark)) padding-box, var(--cta-gold-edge) border-box; box-shadow: 0 8px 20px rgba(9, 22, 43, 0.22), 0 0 12px rgba(207, 164, 70, 0.12); font-size: .92rem; font-weight: 650; letter-spacing: .02em; text-align: center; text-decoration: none; text-shadow: none; -webkit-text-stroke: 0; transition: background .2s ease, box-shadow .2s ease, transform .2s ease; }
  .button-primary { position: relative; isolation: isolate; overflow: hidden; width: fit-content; padding: 18px 36px; border: 1px solid rgba(26,26,26,.12); border-top: 1px solid rgba(255,255,255,.4); border-radius: 10px; color: #1A1A1A; background: linear-gradient(180deg, #EBC05B 0%, #D5A232 100%); box-shadow: 0 8px 20px -4px rgba(0,0,0,.35); font-size: 16px; font-weight: 600; letter-spacing: -.01em; gap: 10px; text-shadow: none; -webkit-text-stroke: 0; transition: all .25s cubic-bezier(.22,1,.36,1); }
  .button-primary::after { position: absolute; z-index: -1; top: 0; bottom: 0; left: 0; width: 58%; border-radius: inherit; background: linear-gradient(105deg, transparent 8%, rgba(255,255,255,.5) 48%, transparent 88%); content: ""; opacity: 0; pointer-events: none; transform: translateX(-150%) skewX(-18deg); animation: button-shimmer 5s ease-in-out infinite; }
  .button-primary span { font-size: 1rem; transition: transform .25s cubic-bezier(.22,1,.36,1); }
  .button-primary:hover { color: #1A1A1A; transform: translateY(-2px); box-shadow: 0 12px 26px -4px rgba(0,0,0,.4); }
  .button-primary:hover span { transform: translateX(4px); }
  .button-primary:active { transform: scale(.98) translateY(0); box-shadow: 0 4px 10px -4px rgba(0,0,0,.38); }
  .mobile-sticky-cta { display: none; }
  .hero-footer { display: flex; align-items: center; justify-content: space-between; gap: 18px; margin-top: auto; }
  .scroll-cue { display: inline-flex; align-items: center; gap: 10px; color: #fff; font-size: .78rem; text-decoration: none; }
  .scroll-cue span { color: var(--gold-on-dark); transition: transform .2s ease; }
  .scroll-cue:hover span { animation: scroll-arrow-bob .65s ease-in-out infinite; }
  @media (min-width: 900px) { .hero-wrap, .header-inner { padding-right: 22px; padding-left: 22px; } }
  @media (max-width: 719px) {
    .hero { min-height: 100svh; }
    .hero-photo { object-position: 57% center; }
    .hero-shade { background: linear-gradient(180deg, rgba(7, 18, 37, 0.88) 0%, rgba(9, 22, 43, 0.78) 45%, rgba(9, 22, 43, 0.48) 75%, rgba(7, 18, 37, 0.9) 100%); }
    .site-header { height: 76px; }
    .header-inner { min-height: 76px; padding: 0 18px; }
    .hero-wrap { width: 100%; min-height: 100svh; padding: 92px 18px 0; }
    .brand { gap: 10px; }
    .brand img { width: 52px; }
    .brand-copy strong { font-size: .98rem; }
    .brand-copy span { max-width: 240px; font-size: .71rem; }
    .desktop-nav { display: none; }
    .mobile-nav { position: static; display: block; color: #fff; }
    .mobile-nav summary { display: grid; place-items: center; width: 46px; height: 46px; color: #fff; list-style: none; cursor: pointer; }
    .mobile-nav summary::-webkit-details-marker { display: none; }
    .menu-icon { position: relative; display: grid; align-content: center; gap: 5px; width: 24px; height: 22px; }
    .menu-icon i { display: block; width: 24px; height: 2px; background: var(--gold-on-dark); transition: transform .18s ease, opacity .18s ease; }
    .mobile-nav[open] .menu-icon i:first-child { transform: translateY(7px) rotate(45deg); }
    .mobile-nav[open] .menu-icon i:nth-child(2) { opacity: 0; }
    .mobile-nav[open] .menu-icon i:last-child { transform: translateY(-7px) rotate(-45deg); }
    .mobile-menu { position: absolute; z-index: 31; top: 100%; left: 0; display: grid; width: 100%; max-height: 0; overflow: hidden; padding: 0 22px; border-top: 1px solid transparent; border-bottom: 1px solid transparent; background: var(--landing-navy); opacity: 0; visibility: hidden; transform: translateY(-7px); transition: max-height .28s ease, opacity .22s ease, transform .22s ease, visibility .22s ease, padding .22s ease, border-color .22s ease; }
  .site-header:has(.mobile-nav[open]) .mobile-menu { max-height: 340px; padding: 8px 22px 16px; border-color: color-mix(in srgb, var(--gold-on-dark) 32%, transparent); opacity: 1; visibility: visible; transform: translateY(0); }
    .mobile-menu a { padding: 14px 2px; border-bottom: 1px solid rgba(255,255,255,.14); color: #f3f4f6; font-size: .96rem; text-decoration: none; }
    .mobile-menu a:last-child { border-bottom: 0; }
    .mobile-menu a:hover { color: var(--gold-on-dark); }
    .hero-content { margin: 0; padding: clamp(60px, 9svh, 95px) 0 clamp(50px, 8svh, 82px); }
    .hero-copy { max-width: 540px; }
    .hero-eyebrow { margin-bottom: 12px; color: var(--gold-on-dark); font-size: .7rem; letter-spacing: .08em; text-shadow: none; }
    h1 { font-size: clamp(2.5rem, 10.8vw, 4rem); font-weight: 650; line-height: 1; }
    .descriptor { margin-top: 11px; font-size: .88rem; }
    .lead { max-width: 400px; margin: 13px 0 0; font-size: .95rem; line-height: 1.5; }
    .hero-copy > .button { margin-top: 32px; }
    .hero-footer { align-items: flex-end; padding-bottom: max(24px, env(safe-area-inset-bottom)); }
    .scroll-cue { gap: 7px; font-size: .7rem; white-space: nowrap; }
    .mobile-sticky-cta { position: fixed; z-index: 25; isolation: isolate; overflow: hidden; bottom: max(16px, env(safe-area-inset-bottom)); left: 50%; display: inline-flex; align-items: center; justify-content: center; gap: 10px; width: min(360px, calc(100vw - 36px)); min-width: min(300px, calc(100vw - 36px)); max-width: calc(100vw - 36px); min-height: 46px; padding: 12px 20px; transform: translate(-50%, 8px); border: 1px solid rgba(26,26,26,.12); border-top: 1px solid rgba(255,255,255,.4); border-radius: 10px; color: #1A1A1A; background: linear-gradient(180deg, #EBC05B 0%, #D5A232 100%); box-shadow: 0 10px 25px -3px rgba(0,0,0,.45), 0 4px 10px -2px rgba(213,162,50,.25); font-size: 15px; font-weight: 600; letter-spacing: -.01em; text-decoration: none; text-shadow: none; -webkit-text-stroke: 0; opacity: 0; visibility: hidden; transition: all .3s cubic-bezier(.22,1,.36,1); }
    .mobile-sticky-cta::after { position: absolute; z-index: -1; top: 0; bottom: 0; left: 0; width: 58%; border-radius: inherit; background: linear-gradient(105deg, transparent 8%, rgba(255,255,255,.5) 48%, transparent 88%); content: ""; opacity: 0; pointer-events: none; transform: translateX(-150%) skewX(-18deg); animation: button-shimmer 5s ease-in-out infinite; }
    .mobile-sticky-cta:hover { box-shadow: 0 12px 28px -3px rgba(0,0,0,.48), 0 5px 12px -2px rgba(213,162,50,.3); }
    .mobile-sticky-cta:active { transform: translate(-50%, 0) scale(.98); }
    .mobile-sticky-cta[data-visible] { transform: translate(-50%, 0); opacity: 1; visibility: visible; }
    .mobile-sticky-cta[data-entrance] { animation: cta-entrance .55s ease-out 1 both; }
    .mobile-sticky-cta span { font-size: 1.1rem; }
  }
  @media (max-width: 719px) { .button-primary { width: 100%; padding: 16px 24px; } }
  @media (min-width: 720px) { .site-header { height: 88px; } .mobile-nav, .mobile-menu, .mobile-sticky-cta { display: none !important; } .desktop-nav { display: flex !important; } }
  @media (max-width: 380px) { .hero-wrap, .header-inner { padding-right: 16px; padding-left: 16px; } .hero-content { padding: 52px 0 48px; } h1 { font-size: 2.4rem; } .scroll-cue { font-size: .64rem; } .mobile-sticky-cta { max-width: calc(100vw - 32px); padding-right: 16px; padding-left: 16px; } }
  @keyframes cta-entrance { 0% { opacity: 0; transform: translate(-50%, 12px) scale(.98); box-shadow: 0 0 0 rgba(207,164,70,0); } 72% { opacity: 1; transform: translate(-50%, -2px) scale(1.01); box-shadow: 0 0 22px rgba(207,164,70,.28); } 100% { opacity: 1; transform: translate(-50%, 0) scale(1); box-shadow: 0 4px 14px rgba(207,164,70,.2); } }
  @keyframes button-shimmer { 0%, 82%, 100% { opacity: 0; transform: translateX(-150%) skewX(-18deg); } 84% { opacity: .32; } 96% { opacity: 0; transform: translateX(230%) skewX(-18deg); } }
  @keyframes scroll-arrow-bob { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(3px); } }
  @media (prefers-reduced-motion: reduce) { .button, .button-primary span, .scroll-cue span { transition: none; animation: none !important; } .button-primary::after { animation: none; } }
  @media (prefers-reduced-motion: reduce) { .menu-icon i { transition: none; } }
  @media (prefers-reduced-motion: reduce) { .mobile-sticky-cta { transition: none; animation: none !important; } }
</style>
